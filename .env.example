# ==============================================================================
# IronWarden Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` before running IronWarden:
#   cp .env.example .env
#
# Generate RSA keypair for JWT authentication:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# ==============================================================================

# --- Gateway & Network Settings ---
PORT=8080
BRIDGE_PORT=8080
BRIDGE_ADDR=0.0.0.0
MCP_PORT=14141
RUST_LOG=info
LOG_FORMAT=text

# --- Deployment Environment ---
# Environment profile: development | production | test | ephemeral
WARDEN_ENV=production

# Deployment Mode: bridge | hybrid | standalone | HA
WARDEN_MODE=bridge

# Allow fallback to default configurations if config/config.yaml is missing
ALLOW_FALLBACK=true

# Ignore HA remote audit endpoint enforcement in standalone/local setups
IGNORE_HA_ENFORCEMENT=true

# --- Cryptographic & Security Keys ---
# 32-byte secret pepper for HMAC audit ledger integrity and payload binding (Required)
# Example: Generate with `openssl rand -hex 32`
WARDEN_PEPPER=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret token for MCP Control Plane authentication
WARDEN_MCP_SECRET=default_mcp_secret_change_in_production

# --- JWT Authentication (RS256) ---
# RS256 Public Key (PEM format) used by IronWarden to verify client JWT Bearer tokens.
# Paste the full PEM string including headers, or set single-line with escaped newlines.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEArpp/54K63vJ1qBeD6mnn
e/Zxioj0KsP+Il+MXM9JWPASVbqGaanSU2QZP6WXKzSSCLehHnriE0/0+UvAxwF/
dIN1bJAO0gMBrdbp2qCoa6wEpzW6gLmMGPwL2XcfrlnviyNE160T/sOXWSoqU3xv
5qYcNdeEHO8LobsLBCtRlu7BkPSjv41rHAixl6UttAf7ArWGU+lSs4MSs7lBT26z
FGA/DBqIKMrl7C2LrAYPdvzJ7Ri3Udt81n8nXMoa8F+2juCMH+oxzFzPacGw8L47
wyuKjtfsubRkz51ggFDaqltzYFvbSvnrA68Y037h2aCkytlFncXVxYT6vWw6XBvu
3wIDAQAB
-----END PUBLIC KEY-----"

# RS256 Private Key (PEM format) - used for testing / client token signing scripts
# (Do NOT deploy private keys into production gateway instances)
# JWT_PRIVATE_KEY=""

# JWT Claims Validation
WARDEN_JWT_AUDIENCE=ironwarden
WARDEN_JWT_ISSUER=ironwarden

# --- Upstream AI Providers ---
UPSTREAM_OPENAI_URL=https://api.openai.com
UPSTREAM_ANTHROPIC_URL=https://api.anthropic.com
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Redis & Storage Backends ---
# Redis URL for session persistence and grounding queue (falls back to local Redis in compose)
REDIS_URL=redis://redis:6379
AUDIT_DB_PATH=data/audit.db
KNOWLEDGE_PATH=data/knowledge

# --- ONNX Runtime & AI Worker Pool ---
# Number of parallel ONNX NER inference workers (Recommended: 1 on ARM/Rosetta, 2-4 on Linux x86_64)
WARDEN_NER_POOL_SIZE=1
LD_LIBRARY_PATH=/app/data/models
ORT_DYLIB_PATH=/app/data/models/libonnxruntime.so
